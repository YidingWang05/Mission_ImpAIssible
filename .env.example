# 复制为 .env 并填入自己的 key；不要把 .env 提交到 GitHub（这是公开仓库）
#
# 每个服务可以放多个密钥：NAME、NAME_2、NAME_3 …（空着的会被跳过）。
# 先用第一个；额度不足 / 鉴权失败 / 被限流时自动换下一个（见 keys.js 和 keyring.py）。

# Claude：识别、问答，以及 `npm run agent`（自动改代码的智能体）
ANTHROPIC_API_KEY=
ANTHROPIC_API_KEY_2=
ANTHROPIC_API_KEY_3=
ANTHROPIC_API_KEY_4=

# Anam：数字人
ANAM_API_KEY=
ANAM_API_KEY_2=
ANAM_API_KEY_3=

# fal：每一步的操作演示视频
FAL_KEY=
FAL_KEY_2=

# ElevenLabs：语音（可选）
ELEVENLABS_API_KEY=
ELEVENLABS_API_KEY_2=
ELEVENLABS_API_KEY_3=

# Adaption：不接入主系统，队友手动上传数据
ADAPTION_API_KEY=
ADAPTION_API_KEY_2=
ADAPTION_API_KEY_3=

# ---- 可选 ----
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_ASK_MODEL=
# AGENT_MODEL=claude-opus-5-5
# ANAM_AVATAR_ID=
# ANAM_LLM_ID=
# PORT=8000
# Anam 单个会话的时长上限（秒）。Free 套餐是 180；套餐升级后改大，0 = 不主动续会话
# ANAM_SESSION_LIMIT_SECONDS=180
# Ava 说完后多少秒没人接话就断开会话待机（省分钟数）
# ANAM_IDLE_SECONDS=4
# 设为 1：每讲完一段就停下，等用户说“下一步”
# LESSON_PAUSE_EACH_SECTION=1
