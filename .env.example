# 复制为 .env 并填入自己的 key；不要把 .env 提交到 GitHub
ANTHROPIC_API_KEY=
ANAM_API_KEY=
FAL_KEY=
ELEVENLABS_API_KEY=
# 可选
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_ASK_MODEL=
# ANAM_AVATAR_ID=
# ANAM_LLM_ID=
# PORT=8000
# Anam 单个会话的时长上限（秒）。Free 套餐是 180；套餐升级后改大，0 = 不主动续会话
# ANAM_SESSION_LIMIT_SECONDS=180
# Ava 说完后多少秒没人接话就断开会话待机（省分钟数）
# ANAM_IDLE_SECONDS=4
# 设为 1：每讲完一段就停下，等用户说“下一步”
# LESSON_PAUSE_EACH_SECTION=1
